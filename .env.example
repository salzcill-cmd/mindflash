# ============================================================
# MindFlash — Konfigurasi Environment
# Salin file ini menjadi `.env` lalu isi nilainya.
# ============================================================

# URL project Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Anon public key Supabase (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=

# Contoh:
# VITE_SUPABASE_URL=https://abcdefghijklm.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Catatan:
# - Tanpa .env, aplikasi tetap bisa dijalankan untuk mode guest
#   (data tersimpan di localStorage browser).

# Catatan login Google (opsional, saat ini tidak dipakai):
# Tombol Google di halaman login sengaja tidak ditampilkan. Kalau suatu saat
# ingin mengaktifkannya, ikuti langkah di README.md bagian "Setup Supabase".
# Referensi resmi: https://supabase.com/docs/guides/auth/social-login/auth-google
